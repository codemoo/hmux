# Managed hmux defaults. Add a personal override include after this file.
font-family = ""
font-family-bold = ""
font-family-italic = ""
font-family-bold-italic = ""
font-family = "Monatendard Nerd Font Mono"
font-size = 13
adjust-cell-height = 5%
font-feature = "calt"
font-feature = "liga"
theme = "Flexoki Dark"
window-theme = dark
background = #100F0F
foreground = #CECDC3
cursor-color = #CECDC3
selection-foreground = #CECDC3
selection-background = #403E3C
palette = 0=#100F0F
palette = 1=#AF3029
palette = 2=#66800B
palette = 3=#AD8301
palette = 4=#205EA6
palette = 5=#A02F6F
palette = 6=#24837B
palette = 7=#878580
palette = 8=#6F6E69
palette = 9=#D14D41
palette = 10=#879A39
palette = 11=#D0A215
palette = 12=#4385BE
palette = 13=#CE5D97
palette = 14=#3AA99F
palette = 15=#CECDC3
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-padding-color = background

# Keep terminal URLs discoverable on Cmd-hover and open them with the macOS
# default browser on Cmd-click. Ghostty performs the match and system-open
# action itself; hmux never executes text copied from a terminal pane.
link-url = true
link-previews = true

# Private hmux-frame sequences. Only the disposable outer frame recognizes
# them, so the target tmux server and clients from other services stay native.
keybind = cmd+l=text:\x1b[5;9010~
keybind = cmd+grave_accent=text:\x1b[5;9010~
keybind = cmd+w=text:\x1b[5;9011~
keybind = cmd+q=text:\x1b[5;9012~
keybind = cmd+r=text:\x1b[5;9013~
keybind = cmd+digit_1=text:\x1b[5;9021~
keybind = cmd+digit_2=text:\x1b[5;9022~
keybind = cmd+digit_3=text:\x1b[5;9023~
keybind = cmd+digit_4=text:\x1b[5;9024~
keybind = cmd+digit_5=text:\x1b[5;9025~
keybind = cmd+digit_6=text:\x1b[5;9026~
keybind = cmd+digit_7=text:\x1b[5;9027~
keybind = cmd+digit_8=text:\x1b[5;9028~
keybind = cmd+digit_9=text:\x1b[5;9029~
