#!/bin/sh
set -eu

CACHE_DIR="${HMUX_CACHE_DIR:-$HOME/.cache/hmux}"
CURRENT="$CACHE_DIR/current"
DMZ_ALIAS="${HMUX_DMZ_ALIAS:-hmux-dmz}"
CONTROL="${HMUX_CONTROL_PATH:-~/.local/bin/hmux-control}"
PUBLIC_KEY="${HMUX_PUBLIC_KEY_PATH:-$HOME/.config/hmux/release-public-key.pem}"
DOWNLOAD_TIMEOUT_SECONDS="${HMUX_BOOTSTRAP_DOWNLOAD_TIMEOUT_SECONDS:-300}"
case "$DOWNLOAD_TIMEOUT_SECONDS" in '' | *[!0-9]*)
	echo "hmux: invalid bootstrap download timeout" >&2
	exit 1
	;;
esac
[ "$DOWNLOAD_TIMEOUT_SECONDS" -ge 1 ] && [ "$DOWNLOAD_TIMEOUT_SECONDS" -le 300 ] || {
	echo "hmux: bootstrap download timeout must be between 1 and 300 seconds" >&2
	exit 1
}
case "$CACHE_DIR" in /*) ;; *)
	echo "hmux: cache directory must be absolute" >&2
	exit 1
	;;
esac
[ "$CACHE_DIR" != / ] || {
	echo "hmux: refusing filesystem-root cache directory" >&2
	exit 1
}
for dir in "$CACHE_DIR" "$CACHE_DIR/releases"; do
	if [ -L "$dir" ] || { [ -e "$dir" ] && [ ! -d "$dir" ]; }; then
		echo "hmux: cache paths must be real directories, not symlinks" >&2
		exit 1
	fi
done
mkdir -p "$CACHE_DIR/releases"
chmod 700 "$CACHE_DIR" "$CACHE_DIR/releases"
for dir in "$CACHE_DIR" "$CACHE_DIR/releases"; do
	[ "$(stat -f '%u' "$dir")" = "$(id -u)" ] &&
		[ -z "$(find "$dir" -prune -perm -022 -print)" ] || {
		echo "hmux: cache directory ownership or mode is unsafe" >&2
		exit 1
	}
done
PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
[ "$PLATFORM" = "darwin-x86_64" ] && PLATFORM="darwin-amd64"
case "$PLATFORM" in darwin-arm64 | darwin-amd64) ;; *)
	echo "hmux: unsupported bootstrap platform: $PLATFORM" >&2
	exit 1
	;;
esac
case "$DMZ_ALIAS" in '' | -* | *[!A-Za-z0-9._-]*)
	echo "hmux: unsafe DMZ alias" >&2
	exit 1
	;;
esac
case "$CONTROL" in '' | *[!A-Za-z0-9~_./-]*)
	echo "hmux: unsafe control path" >&2
	exit 1
	;;
esac

download_limited() {
	maximum="$1"
	target="$2"
	shift 2
	case "$maximum" in '' | *[!0-9]*)
		echo "hmux: invalid download size limit" >&2
		return 1
		;;
	esac
	[ "$maximum" -ge 1 ] || return 1
	# POSIX sh reports the file-size limit in 512-byte blocks. The exact byte
	# count is checked again afterward, so a final partial block cannot bypass
	# the declared limit.
	blocks=$(((maximum + 511) / 512))
	if ! (
		ulimit -f "$blocks"
		exec /usr/bin/perl -e '
          my $seconds = shift @ARGV;
          alarm $seconds;
          exec @ARGV or die "exec failed\n";
        ' "$DOWNLOAD_TIMEOUT_SECONDS" "$@" >"$target"
	); then
		rm -f "$target"
		echo "hmux: bounded release download failed" >&2
		return 1
	fi
	actual="$(wc -c <"$target" | tr -d ' ')"
	case "$actual" in '' | *[!0-9]*) return 1 ;; esac
	if [ "$actual" -gt "$maximum" ]; then
		rm -f "$target"
		echo "hmux: release download exceeded its size limit" >&2
		return 1
	fi
}

if [ ! -x "$CURRENT" ]; then
	for tool in jq openssl shasum ssh; do
		command -v "$tool" >/dev/null 2>&1 || {
			echo "hmux: $tool is required for first bootstrap" >&2
			exit 1
		}
	done
	[ -x /usr/bin/perl ] || {
		echo "hmux: /usr/bin/perl is required for bounded bootstrap downloads" >&2
		exit 1
	}
	[ -f "$PUBLIC_KEY" ] || {
		echo "hmux: pinned release public key is required for first bootstrap" >&2
		exit 1
	}
	[ ! -L "$PUBLIC_KEY" ] &&
		[ "$(stat -f '%u' "$PUBLIC_KEY")" = "$(id -u)" ] &&
		[ -z "$(find "$PUBLIC_KEY" -prune -perm -022 -print)" ] || {
		echo "hmux: pinned release public key ownership or mode is unsafe" >&2
		exit 1
	}
	TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/hmux-bootstrap.XXXXXX")"
	trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
	download_limited 1048576 "$TMP_DIR/manifest.json" \
		ssh -o BatchMode=yes -o ForwardAgent=no -o ClearAllForwardings=yes \
		-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 \
		"$DMZ_ALIAS" -- "$CONTROL" manifest --platform "$PLATFORM"
	jq -e '
	  type == "object" and
	  ((keys_unsorted - [
	    "schema_version", "version", "platform", "artifact", "sha256",
	    "size", "published_at", "min_protocol", "signature_type",
	    "signature", "manifest_signature", "key_id"
	  ]) | length == 0)
	' "$TMP_DIR/manifest.json" >/dev/null || {
		echo "hmux: manifest contains unknown fields" >&2
		exit 1
	}
	VERSION="$(jq -er '.version' "$TMP_DIR/manifest.json")"
	if [ "${#VERSION}" -gt 64 ] ||
		! printf '%s\n' "$VERSION" | grep -Eq '^[0-9]+(\.[0-9]+){1,3}([-+][A-Za-z0-9][A-Za-z0-9.-]{0,31})?$'; then
		echo "hmux: invalid release version" >&2
		exit 1
	fi
	[ "$(jq -er '.schema_version' "$TMP_DIR/manifest.json")" = 1 ] &&
		[ "$(jq -er '.platform' "$TMP_DIR/manifest.json")" = "$PLATFORM" ] &&
		[ "$(jq -er '.artifact' "$TMP_DIR/manifest.json")" = hmux ] &&
		[ "$(jq -er '.signature_type' "$TMP_DIR/manifest.json")" = ed25519-manifest-v1 ] || {
		echo "hmux: invalid signed manifest metadata" >&2
		exit 1
	}
	EXPECTED_SHA="$(jq -er '.sha256' "$TMP_DIR/manifest.json")"
	EXPECTED_SIZE="$(jq -er '.size' "$TMP_DIR/manifest.json")"
	KEY_ID="$(jq -er '.key_id' "$TMP_DIR/manifest.json")"
	MIN_PROTOCOL="$(jq -er '.min_protocol' "$TMP_DIR/manifest.json")"
	printf '%s\n' "$EXPECTED_SHA" | grep -Eq '^[a-f0-9]{64}$' || {
		echo "hmux: invalid artifact checksum metadata" >&2
		exit 1
	}
	case "$EXPECTED_SIZE" in '' | *[!0-9]*) exit 1 ;; esac
	[ "$EXPECTED_SIZE" -ge 1 ] && [ "$EXPECTED_SIZE" -le 268435456 ] || exit 1
	[ "$MIN_PROTOCOL" = 1 ] || {
		echo "hmux: unsupported release protocol" >&2
		exit 1
	}
	printf '%s\n' "$KEY_ID" | grep -Eq '^[a-f0-9]{16}$' || exit 1
	PINNED_KEY_ID="$(openssl pkey -pubin -in "$PUBLIC_KEY" -outform DER 2>/dev/null |
		shasum -a 256 | awk '{print substr($1,1,16)}')"
	[ "$KEY_ID" = "$PINNED_KEY_ID" ] || {
		echo "hmux: release signing key id mismatch" >&2
		exit 1
	}
	download_limited "$EXPECTED_SIZE" "$TMP_DIR/hmux" \
		ssh -o BatchMode=yes -o ForwardAgent=no -o ClearAllForwardings=yes \
		-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 \
		"$DMZ_ALIAS" -- "$CONTROL" artifact --platform "$PLATFORM" --version "$VERSION"
	[ "$(wc -c <"$TMP_DIR/hmux" | tr -d ' ')" = "$EXPECTED_SIZE" ] || exit 1
	[ "$(shasum -a 256 "$TMP_DIR/hmux" | awk '{print $1}')" = "$EXPECTED_SHA" ] || exit 1
	jq -cj '{
    domain:"hmux-release-manifest-v1",
    schema_version:.schema_version,
    version:.version,
    platform:.platform,
    artifact:.artifact,
    sha256:(.sha256|ascii_downcase),
    size:.size,
    published_at:.published_at,
    min_protocol:.min_protocol,
    signature_type:.signature_type,
    key_id:.key_id
  }' "$TMP_DIR/manifest.json" >"$TMP_DIR/signature-payload.json"
	jq -er '.manifest_signature' "$TMP_DIR/manifest.json" |
		openssl base64 -d -A -out "$TMP_DIR/signature.bin"
	openssl pkeyutl -verify -pubin -inkey "$PUBLIC_KEY" -rawin \
		-in "$TMP_DIR/signature-payload.json" -sigfile "$TMP_DIR/signature.bin" >/dev/null || {
		echo "hmux: release signature verification failed" >&2
		exit 1
	}
	RELEASE_DIR="$CACHE_DIR/releases/$VERSION"
	if [ -L "$RELEASE_DIR" ] || { [ -e "$RELEASE_DIR" ] && [ ! -d "$RELEASE_DIR" ]; }; then
		echo "hmux: unsafe cached release path" >&2
		exit 1
	fi
	if [ -d "$RELEASE_DIR" ]; then
		if [ -L "$RELEASE_DIR/hmux" ] || [ ! -f "$RELEASE_DIR/hmux" ] ||
			[ -L "$RELEASE_DIR/manifest.json" ] || [ ! -f "$RELEASE_DIR/manifest.json" ] ||
			! cmp -s "$TMP_DIR/hmux" "$RELEASE_DIR/hmux" ||
			! cmp -s "$TMP_DIR/manifest.json" "$RELEASE_DIR/manifest.json"; then
			echo "hmux: existing cached release is immutable and differs" >&2
			exit 1
		fi
	else
		STAGE_DIR="$(mktemp -d "$CACHE_DIR/releases/.$VERSION-stage.XXXXXX")"
		chmod 700 "$STAGE_DIR"
		install -m 700 "$TMP_DIR/hmux" "$STAGE_DIR/hmux"
		install -m 600 "$TMP_DIR/manifest.json" "$STAGE_DIR/manifest.json"
		mv "$STAGE_DIR" "$RELEASE_DIR"
	fi
	ln -sfn "releases/$VERSION/hmux" "$CACHE_DIR/current.next"
	mv -f "$CACHE_DIR/current.next" "$CURRENT"
fi
exec "$CURRENT" "$@"
