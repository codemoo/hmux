# HMux-owned Ghostty surface defaults. This file is intentionally independent
# of the user's Ghostty configuration so a broken terminal preference cannot
# prevent the HMux session catalog from opening.
font-size = 13
link-url = true
link-previews = true
window-save-state = never
# CVDisplayLink creation can fail on headless or remotely-driven Macs. Ghostty's
# non-vsync renderer remains fully functional and avoids making terminal startup
# depend on an active CoreVideo display link.
window-vsync = false
# HMux surfaces are session-only terminals. Remove Ghostty's global window,
# tab, split, and quick-terminal key actions while keeping core terminal UX
# and the standard macOS application quit shortcut.
keybind = clear
keybind = cmd+q=quit
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+a=select_all
keybind = cmd+f=start_search
keybind = cmd+enter=toggle_fullscreen

# Flexoki Dark: euandeas/omarchy-flexoki-dark-theme @ aa418ffb68ec1eaa72a85b02970ada07ce6f3d26
window-theme = dark
background = #100F0F
foreground = #CECDC3
cursor-color = #CECDC3
cursor-text = #100F0F
selection-background = #403E3C
selection-foreground = #CECDC3
palette = 0=#100F0F
palette = 1=#AF3029
palette = 2=#66800B
palette = 3=#AD8301
palette = 4=#205EA6
palette = 5=#A02F6F
palette = 6=#24837B
palette = 7=#878580
palette = 8=#6F6E69
palette = 9=#D14D41
palette = 10=#879A39
palette = 11=#D0A215
palette = 12=#4385BE
palette = 13=#CE5D97
palette = 14=#3AA99F
palette = 15=#CECDC3
