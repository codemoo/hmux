+/// A Command/Ctrl-click that started on a link while terminal mouse reporting
+/// was active. The terminal must not receive any part of this gesture: sending
+/// only a press or only a release leaves mouse-aware applications in a broken
+/// state.
+pub const PendingLinkClick = struct {
+    origin: terminal.point.Coordinate,
+    fingerprint: LinkFingerprint,
+    valid: bool = true,
+
+    /// Update the gesture for pointer movement. Once invalidated, a gesture
+    /// stays invalid until its release is consumed.
+    pub fn update(
+        self: *PendingLinkClick,
+        point: ?terminal.point.Coordinate,
+        exact_modifier: bool,
+    ) void {
+        if (!self.valid) return;
+        const current = point orelse {
+            self.valid = false;
+            return;
+        };
+        if (!exact_modifier or !self.origin.eql(current)) self.valid = false;
+    }
+
+    pub fn cancel(self: *PendingLinkClick) void {
+        self.valid = false;
+    }
+
+    pub fn gestureIsValid(
+        self: PendingLinkClick,
+        point: ?terminal.point.Coordinate,
+        exact_modifier: bool,
+    ) bool {
+        if (!self.valid or !exact_modifier) return false;
+        const current = point orelse return false;
+        return self.origin.eql(current);
+    }
+
+    pub fn shouldActivate(
+        self: PendingLinkClick,
+        point: ?terminal.point.Coordinate,
+        exact_modifier: bool,
+        fingerprint: ?LinkFingerprint,
+    ) bool {
+        if (!self.gestureIsValid(point, exact_modifier)) return false;
+        const current = fingerprint orelse return false;
+        return std.mem.eql(u8, &self.fingerprint, &current);
+    }
+};
+
+pub const LinkFingerprint = [32]u8;
+
+pub fn linkFingerprint(value: []const u8) LinkFingerprint {
+    var result: LinkFingerprint = undefined;
+    std.crypto.hash.Blake3.hash(value, &result, .{});
+    return result;
+}
+
+/// Links use the platform's primary shortcut modifier and no other binding
+/// modifier. Lock state and left/right modifier identity are intentionally
+/// ignored, matching Ghostty's existing link configuration behavior.
+pub fn exactLinkModifier(mods: input.Mods) bool {
+    return mods.binding().equal(input.ctrlOrSuper(.{}));
+}
