+test "pending link click activates only in its origin cell" {
+    const testing = std.testing;
+    const origin: terminal.point.Coordinate = .{ .x = 3, .y = 7 };
+    const fingerprint = linkFingerprint("https://example.com/a");
+
+    var click: PendingLinkClick = .{ .origin = origin, .fingerprint = fingerprint };
+    click.update(origin, true);
+    try testing.expect(click.shouldActivate(origin, true, fingerprint));
+    try testing.expect(!click.shouldActivate(origin, false, fingerprint));
+    try testing.expect(!click.shouldActivate(null, true, fingerprint));
+    try testing.expect(!click.shouldActivate(
+        origin,
+        true,
+        linkFingerprint("https://example.com/b"),
+    ));
+}
+
+test "pending link click remains cancelled after movement" {
+    const testing = std.testing;
+    const origin: terminal.point.Coordinate = .{ .x = 3, .y = 7 };
+    const fingerprint = linkFingerprint("https://example.com");
+
+    var click: PendingLinkClick = .{ .origin = origin, .fingerprint = fingerprint };
+    click.update(.{ .x = 4, .y = 7 }, true);
+    try testing.expect(!click.valid);
+
+    click.update(origin, true);
+    try testing.expect(!click.shouldActivate(origin, true, fingerprint));
+}
+
+test "pending link click is cancelled when its modifier changes" {
+    const testing = std.testing;
+    const origin: terminal.point.Coordinate = .{ .x = 3, .y = 7 };
+    const fingerprint = linkFingerprint("https://example.com");
+
+    var click: PendingLinkClick = .{ .origin = origin, .fingerprint = fingerprint };
+    click.update(origin, false);
+    try testing.expect(!click.shouldActivate(origin, true, fingerprint));
+}
+
+test "exact link modifier rejects additional binding modifiers" {
+    const testing = std.testing;
+    const expected = input.ctrlOrSuper(.{});
+
+    try testing.expect(exactLinkModifier(expected));
+
+    var extra = expected;
+    extra.shift = true;
+    try testing.expect(!exactLinkModifier(extra));
+
+    extra = expected;
+    extra.alt = true;
+    try testing.expect(!exactLinkModifier(extra));
+}
