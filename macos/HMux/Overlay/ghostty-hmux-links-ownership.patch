+/// Clear link hover state after a modifier-based mouse capture override ends.
+/// This function must be called without the renderer mutex held.
+fn clearMouseLinkOverride(self: *Surface, capture_only: bool) void {
+    const should_notify = should_notify: {
+        self.renderer_state.mutex.lock();
+        defer self.renderer_state.mutex.unlock();
+
+        if (capture_only and self.io.terminal.flags.mouse_event == .none) {
+            break :should_notify false;
+        }
+
+        const active = self.mouse.over_link or self.mouse.link_point != null;
+        self.mouse.over_link = false;
+        self.mouse.link_point = null;
+        self.renderer_state.mouse.point = null;
+        self.renderer_state.terminal.screens.active.dirty.hyperlink_hover = true;
+        break :should_notify active;
+    };
+
+    if (!should_notify) return;
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .mouse_shape,
+        self.io.terminal.mouse_shape,
+    ) catch |err| {
+        log.warn("failed to restore mouse shape after link override err={}", .{err});
+    };
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .mouse_over_link,
+        .{ .url = "" },
+    ) catch |err| {
+        log.warn("failed to clear link preview after override err={}", .{err});
+    };
+    self.queueRender() catch |err| {
+        log.warn("failed to render cleared link override err={}", .{err});
+    };
+}
